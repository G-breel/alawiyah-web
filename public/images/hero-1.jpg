<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
    <defs>
      <linearGradient id="g_hero_1_jpg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2C5F2D" />
        <stop offset="100%" stop-color="#1e401f" />
      </linearGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-opacity="0.05" stroke-width="1"/>
      </pattern>
    </defs>
    <rect width="800" height="600" fill="url(#g_hero_1_jpg)" />
    <rect width="800" height="600" fill="url(#grid)" />
    <circle cx="400" cy="230" r="80" fill="white" fill-opacity="0.1" />
    <text x="400" y="260" font-size="70" text-anchor="middle">🕌</text>
    <text x="400" y="370" font-family="sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Selamat Datang di Al-Alawiyah</text>
    <text x="400" y="415" font-family="sans-serif" font-size="18" fill="#FFB800" text-anchor="middle">Yayasan Modern Al-Alawiyah Bogor</text>
    <rect x="320" y="445" width="160" height="3" fill="#FFB800" rx="1.5" />
    <text x="400" y="540" font-family="sans-serif" font-size="14" fill="white" fill-opacity="0.5" text-anchor="middle">Yayasan Modern Al-Alawiyah</text>
